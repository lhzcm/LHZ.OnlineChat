# ==================== DeepSeek 机器人插件配置 ====================
# 复制为 .env 后按需修改；所有项也支持直接以环境变量传入

# DeepSeek API Key（https://platform.deepseek.com 获取）
# 留空 = 模拟模式：不调真实 API，回复回显你的输入（便于无 Key 联调）
DEEPSEEK_API_KEY=

# DeepSeek 接口地址与模型（默认即可）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 站点地址：机器人推送回复用（生产改为你的站点，如 https://chat.onlinemusic.top）
BOT_ORIGIN=http://localhost:8080

# 机器人的推送令牌（机器人管理面板「复制调用链接」里 /api/robots/{令牌}/reply 的令牌）
# 支持多机器人：BOT_ROBOT_TOKENS="10112:令牌1,10113:令牌2"（按机器人账号 ID 区分），
# 未匹配时回退用 BOT_ROBOT_TOKEN
BOT_ROBOT_TOKEN=

# 机器人的「签名密钥」（创建/编辑机器人时填写的 WebhookSecret）。
# 配置后：系统→插件的回调验签、插件→系统的推送签名都启用；留空则都不启用。
# 注意：机器人配置里填的 WebhookSecret 必须与本值一致。
# BOT_SECRET=

# 收到消息时先推送「🤔 正在思考…」的过程通知
# BOT_THINKING_NOTICE=true

# 对话记忆：每个会话保留最近 N 轮上下文
# BOT_MEMORY=true
# BOT_MEMORY_ROUNDS=10

# 监听端口
# BOT_PORT=9311
