# ==================== DeepSeek Harness 机器人插件配置 ====================
# 复制为 .env 后按需修改；所有项也支持直接以环境变量传入

# 站点地址：机器人推送回复用（生产改为你的站点，如 https://chat.onlinemusic.top）
BOT_ORIGIN=http://localhost:8080

# 机器人的推送令牌（机器人管理面板「复制调用链接」里 /api/robots/{令牌}/reply 的令牌）
# 支持多机器人：BOT_ROBOT_TOKENS="10112:令牌1,10113:令牌2"（按机器人账号 ID 区分），
# 未匹配时回退用 BOT_ROBOT_TOKEN
BOT_ROBOT_TOKEN=

# 机器人的「签名密钥」（创建/编辑机器人时填写的 WebhookSecret）。
# 配置后：系统→插件的回调验签、插件→系统的推送签名都启用；留空则都不启用。
# BOT_SECRET=

# ---- DeepSeek Harness 执行配置 ----
# dsh 命令（默认 PATH 中的 dsh）。
# Windows 下 pnpm/npm 是 .cmd shim 无法被 spawn 直接执行，推荐：
#   DSH_CMD=node
#   DSH_SCRIPT=C:/Users/<你>/AppData/Roaming/npm/node_modules/pnpm/bin/pnpm.cjs
#   DSH_ARGS=dsh --profile headless
# DSH_CMD=dsh
# DSH_ARGS=--profile headless
# DSH_SCRIPT=

# dsh 命令的工作目录（开发环境在 deepseek-harness 仓库根目录跑 pnpm dsh 时必须指定
# 为仓库路径，如 DSH_CWD=D:/Study/deepseek-harness；生产环境 dsh 在 PATH 时可不配）
# DSH_CWD=

# 任务工作目录（agent 的可写工作区；默认插件目录下的 workspace/）
# DSH_WORKDIR=

# 单任务超时（毫秒，默认 10 分钟）
# DSH_TIMEOUT_MS=600000

# 任务提交时推送「🧠 任务已提交…」的过程通知
# BOT_START_NOTICE=true

# 结果最大推送长度（服务端单条消息上限 5000 字）
# BOT_RESULT_MAX=4000

# 监听端口
# BOT_PORT=9312
