# ============================================
# OnlineChat 容器化部署配置
#
# 【必读】此文件是部署的强制前提:
#   cp .env.example .env  然后填写下面的"必填项"
# 缺少任一必填项时 docker compose 会直接报错退出(fail fast),
# 不会退回内置默认密码——这是为了避免 .env 忘记创建时把弱口令部署上线。
#
# 标记为"随机"的值请用命令生成,不要手写:
#   openssl rand -base64 24
# 注意:密码会拼进数据库/Redis 连接串,不要包含 ; 和 , 两个字符。
#
# .env 已被 .gitignore 忽略,请勿提交到仓库或贴到聊天工具里。
# ============================================

# ==================== 必填项(缺失则 compose 拒绝启动) ====================

# ---- PostgreSQL ----
POSTGRES_USER=postgres
# 随机。数据库超级用户密码
POSTGRES_PASSWORD=change-me-strong-password

# ---- Redis ----
# 随机。同时作为 redis-server 的 --requirepass 和后端的连接串密码
REDIS_PASSWORD=change-me-strong-redis-password

# ---- JWT 签名密钥 ----
# 随机,至少 32 字符。泄露等于任何人都能伪造登录态
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# ---- 机器人令牌加密密钥 ----
# 随机。留空会退回内置开发密钥,生产环境等于机器人令牌可被伪造
# 注意:下面这个值是仓库里的公开占位串,直接上线会让任何人算出密钥并伪造任意机器人令牌,
#      后端启动时会拒绝(生产环境配置自检),请务必换成 openssl rand -base64 32 的输出
ROBOT_TOKEN_KEY=change-me-to-a-random-robot-token-key

# ==================== 业务配置(可选,留空有明确行为) ====================

# ---- SMTP 邮件(用于发送注册验证码;留空则验证码打印到后端日志并随接口返回)----
SMTP_HOST=
SMTP_PORT=465
SMTP_ENABLE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@onlinechat.local

# ---- CORS 允许来源(多个用逗号分隔;与站点同域部署时可不限制)----
CORS_ORIGINS=*

# ---- 管理后台(Admin 表为空时自动创建初始超级管理员;访问 /admin)----
# 强烈建议改成强密码:初始管理员拥有最高权限。
# 留成下面的占位值会被后端的生产环境配置自检拒绝启动(该口令是公开的,等于后台无鉴权)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-admin-password

# ---- 机器人 Webhook 是否允许指向内网/本机地址(默认 false)----
# 地址由用户填写、由服务端主动 POST;放行内网等于让注册用户借服务端访问
# 云元数据(169.254.169.254)与内网服务(SSRF)。只有自建 Webhook 确实在内网时才开
ROBOT_ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# ---- 前端 WebSocket 地址(生产 https 站点填 wss://你的域名;留空则自动使用当前站点同域)----
VITE_WS_URL=

# ==================== 宿主端口映射 ====================
# WEB_PORT 会被发布到所有网卡(供宿主机的 Caddy/nginx 反代);
# PG_PORT / REDIS_PORT 只绑定 127.0.0.1,仅供本机管理使用,不会暴露到网络。
# 改这里可避免与本机已有服务冲突。
WEB_PORT=8080
PG_PORT=55432
REDIS_PORT=56379
