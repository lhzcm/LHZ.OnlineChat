# ============================================
# OnlineChat 容器化部署配置
# 使用方法: cp .env.example .env,按需修改后 docker compose up -d
# ============================================

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# ---- JWT 密钥(至少 32 字符的随机串)----
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# ---- SMTP 邮件(用于发送注册验证码;留空则验证码打印到后端日志并随接口返回)----
SMTP_HOST=
SMTP_PORT=465
SMTP_ENABLE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@onlinechat.local

# ---- CORS 允许来源(多个用逗号分隔;与站点同域部署时可不限制)----
CORS_ORIGINS=*

# ---- 机器人令牌加密密钥(任意长随机串;未配置时使用内置开发密钥,生产务必配置)----
ROBOT_TOKEN_KEY=change-me-to-a-random-robot-token-key

# ---- 前端 WebSocket 地址(生产 https 站点填 wss://你的域名;留空则自动使用当前站点同域)----
VITE_WS_URL=

# ---- 宿主端口映射(避免与本机已有服务冲突)----
WEB_PORT=8080
PG_PORT=55432
REDIS_PORT=56379

# ============================================
# DeepSeek 机器人插件(deepseek-bot 服务)
# 机器人 WebhookUrl 填: http://deepseek-bot:9311/hook
# 详见 plugins/deepseek-bot/README.md
# ============================================

# DeepSeek API Key(platform.deepseek.com 获取;留空 = 模拟模式,回复回显输入)
DEEPSEEK_API_KEY=

# 机器人的推送令牌(「我的机器人」→ 复制调用链接里的令牌;支持多机器人用 BOT_ROBOT_TOKENS=账号ID:令牌,账号ID:令牌)
BOT_ROBOT_TOKEN=

# 与机器人配置的 WebhookSecret 一致时启用双向验签(回调验签 + 推送签名);留空不验签
# BOT_SECRET=

# 插件宿主端口(调试/第三方直连用;容器间互访不依赖它)
BOT_PORT=9311
