<Project>
  <!--
    向上再继承一层：仓库根如果放了 Directory.Build.props，必须先导入它。

    非写不可的原因和 tests/Directory.Build.props 里那句一样 —— MSBuild 向上找这个文件时
    「就近取第一个就停」：本文件存在，backend/** 下的工程就不会再往上找，根级配置会被
    静默忽略（不报错，只是不生效）。

    起点必须写成 ../（本文件的上一级）；写成 $(MSBuildThisFileDirectory) 会找到本文件自己，
    变成自导入。

    当前仓库根没有这个文件，条件不成立即跳过，所以现在不改变任何行为；
    加它只是为了让将来把仓库级配置放到根目录时不会踩上面那个坑。
  -->
  <PropertyGroup>
    <_AboveDirectoryBuildProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</_AboveDirectoryBuildProps>
  </PropertyGroup>
  <Import Project="$(_AboveDirectoryBuildProps)" Condition="'$(_AboveDirectoryBuildProps)' != ''" />

  <!-- 四层共用的编译设置（Domain / Application / Infrastructure / Server） -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EffectiveAnalysisLevel>9</EffectiveAnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!--
      有意抑制的分析器规则（每条都与本项目的设计选择直接冲突，而非「懒得改」）：
        CA1000 泛型类型不应有静态成员 —— ApiResponse<T>.Ok/Fail 是对前端的既有契约，不能改签名
        CA1711 类型名不应以 EventHandler 结尾 —— DomainEventHandler<T> 正是 DDD 里该用的名字
        CA1716 参数名不应与保留关键字冲突 —— to / from 在收发消息语境下最贴切
        CA1848 应改用 LoggerMessage 委托 —— 本项目日志量不构成瓶颈，可读性优先
        CA1873 日志参数求值可能昂贵 —— 与 CA1848 成对出现，同理
        CA2007 await 应带 ConfigureAwait —— ASP.NET Core 无同步上下文，仅在库代码显式标注
    -->
    <NoWarn>$(NoWarn);CA1000;CA1711;CA1716;CA1848;CA1873;CA2007</NoWarn>

    <!--
      警告即错误：当前四层 + 三个测试工程都是 0 警告，这条零成本地把它锁住。
      没有它的话，一条新警告会安静地留在构建输出里 —— 而没有人会去翻 CI 日志里的
      「1 Warning」。真需要临时放过某条警告时，用 NoWarn 显式写出来并注明原因，
      这正是本文件上半部分的用法。
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
