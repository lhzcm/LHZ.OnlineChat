<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- 持久化 -->
    <PackageReference Include="FreeSql.Provider.PostgreSQL" Version="3.5.311" />
    <PackageReference Include="FreeSql.Repository" Version="3.5.311" />
    <!-- 缓存 / 会话 / 在线状态 -->
    <PackageReference Include="StackExchange.Redis" Version="3.1.3" />
    <!-- 实时通信（自研 RFC 6455 库；AspNetCore 包会传递引入 LHZ.WebSocket 核心） -->
    <PackageReference Include="LHZ.WebSocket.AspNetCore" Version="1.2.0" />
    <!-- WS 协议 / Webhook 载荷序列化（camelCase 双向兼容） -->
    <PackageReference Include="LHZ.FastJson" Version="2.0.1-pre" />
    <!-- 邮件 / 口令哈希 / 令牌签发 -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <!--
      显式把 MimeKit 传递引入的 Pkcs 顶到修复版（MailKit 4.17.0 → MimeKit 4.17.0 → Pkcs 10.0.0）。
      10.0.0–10.0.12 命中两个 DoS 公告：GHSA-846f-f764-76mx（CVE-2026-84008，High，SignedCms.CheckSignature
      反复重解析 X.509 导致二次方 CPU 耗尽）与 GHSA-2fmv-rv2c-59x7（CVE-2026-70162，Moderate，
      EnvelopedCms.Decode 的同类放大），首个修复版是 10.0.13。不显式引它，NuGet 审计会以 NU1903 报错，
      而本项目开了 TreatWarningsAsErrors —— 直接构建失败。MimeKit 自己升到 >= 10.0.13 后可以删掉这一行。
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    <!-- 宿主集成 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LHZ.OnlineChat.Application\LHZ.OnlineChat.Application.csproj" />
  </ItemGroup>
</Project>
