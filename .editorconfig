# 代码风格基线（IDE / dotnet format / Roslyn 分析器都读这份）。
#
# 只有两类内容：
#   1) 与仓库现状一致的**格式**（缩进、换行、编码），避免各人 IDE 默认值不同产生整文件 diff；
#   2) 少量**已经全仓遵守**的 C# 风格，全部是 suggestion（不升级为 warning）——
#      真正会让构建失败的红线在 backend/Directory.Build.props（TreatWarningsAsErrors + NoWarn），
#      这里不重复、也不与之冲突。
#
# 有意没做的：没有引入 .NET 格式化器/Prettier 之类的工具链，也没有把 analyzer 规则
# 拉到 error —— 那属于另一件事（会一次性产生大量改动），需要单独评估。
root = true

[*]
charset = utf-8
# 换行故意 unset：本仓库用 git 的 core.autocrlf=true 统一（索引里是 LF、按平台检出），
# 编辑器再去强制一边只会产生"整文件 LF/CRLF 翻转"的假改动。只有下面两类必须钉死。
end_of_line = unset
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown 行尾两个空格是硬换行语法，不能裁
[*.{md,markdown}]
trim_trailing_whitespace = false

# Dockerfile / shell 必须是 LF：CRLF 会让 RUN 的续行符和 shebang 失效
[{Dockerfile,*.sh}]
end_of_line = lf
indent_size = 2
[*.{csproj,props,targets,slnx,xml,config,json,jsonc,yml,yaml}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs,vue,css,scss,html}]
indent_size = 2

[*.cs]
# 与既有代码一致：Allman 大括号、file-scoped namespace、不写 this.、别名用内建类型名
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_prefer_braces = when_multiline:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
# var：类型在等号右侧一眼可见时才用，其余写显式类型（与领域代码一致）
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_accessors = when_on_single_line:suggestion

# 生成物不参与格式检查
[**/obj/**]
generated_code = true

[**/bin/**]
generated_code = true

[**/node_modules/**]
generated_code = true

[**/dist/**]
generated_code = true
