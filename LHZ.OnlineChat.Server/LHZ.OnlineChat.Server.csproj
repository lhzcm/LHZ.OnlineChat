<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EffectiveAnalysisLevel>9</EffectiveAnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LHZ.FastJson" Version="2.0.1-pre" />
    <PackageReference Include="LHZ.WebSocket" Version="1.1.1" />
    <PackageReference Include="FreeSql.Provider.PostgreSQL" Version="3.5.311" />
    <PackageReference Include="FreeSql.Repository" Version="3.5.311" />
    <PackageReference Include="LHZ.WebSocket.AspNetCore" Version="1.1.1" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.302">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="StackExchange.Redis" Version="3.1.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Controllers\" />
    <Folder Include="Models\Entities\" />
    <Folder Include="Models\DTOs\" />
    <Folder Include="Services\" />
    <Folder Include="Hubs\" />
    <Folder Include="Config\" />
  </ItemGroup>
</Project>